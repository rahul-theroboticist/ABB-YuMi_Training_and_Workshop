MODULE Module1
    CONST robtarget Right_HomePose:=[[89.387946422,-156.622117956,842.913470217],[0.066010726,-0.842420918,-0.111214912,-0.523068661],[0,0,0,4],[-101.964427132,9E+09,9E+09,9E+09,9E+09,9E+09]];
