    PROC Path_10()
        ConfJ\Off;
        ConfL\Off;
        MoveJ Right_HomePose,v100,fine,Servo\WObj:=RightArm;
        MoveJ Right_StartPose,v100,fine,Servo\WObj:=RightArm;
        MoveJ ApproachTriangle,v100,fine,Servo\WObj:=TriangleObj;
        MoveL PickTriangle,v100,fine,Servo\WObj:=TriangleObj;
        g_GripIn;
        WaitTime 1;
        MoveL ApproachTriangle,v100,fine,Servo\WObj:=TriangleObj;
        MoveL HoverOverTriangle,v100,fine,Servo\WObj:=RightMainHolder;
        MoveL PlaceTriangle,v100,fine,Servo\WObj:=RightMainHolder;
        g_GripOut;
        WaitTime 1;
        MoveL HoverOverTriangle,v100,fine,Servo\WObj:=RightMainHolder;
        MoveL ApproachCshape,v100,fine,Servo\WObj:=CshapeObj;
        MoveL PickCshape,v100,fine,Servo\WObj:=CshapeObj;
        g_GripIn;
        WaitTime 1;
        MoveL ApproachCshape,v100,fine,Servo\WObj:=CshapeObj;
        MoveJ PlaceCshape,v100,fine,Servo\WObj:=RightMainHolder;
        g_GripOut;
        WaitTime 1;
        MoveJ HoverOverCshape,v100,fine,Servo\WObj:=RightMainHolder;
        MoveJ Right_StartPose,v100,fine,Servo\WObj:=RightArm;
        MoveJ HoverOverCshape,v100,fine,Servo\WObj:=RightMainHolder;
        MoveJ PlaceCshape,v100,fine,Servo\WObj:=RightMainHolder;
        g_GripIn;
        WaitTime 1;
        MoveJ HoverOverCshape,v100,fine,Servo\WObj:=RightMainHolder;
        MoveL ApproachCshape,v100,fine,Servo\WObj:=CshapeObj;
        MoveL PickCshape,v100,fine,Servo\WObj:=CshapeObj;
        g_GripOut;
        WaitTime 1;
        MoveL ApproachCshape,v100,fine,Servo\WObj:=CshapeObj;
        MoveL HoverOverTriangle,v100,fine,Servo\WObj:=RightMainHolder;
        MoveL PlaceTriangle,v100,fine,Servo\WObj:=RightMainHolder;
        g_GripIn;
        WaitTime 1;
        MoveL HoverOverTriangle,v100,fine,Servo\WObj:=RightMainHolder;
        MoveJ ApproachTriangle,v100,fine,Servo\WObj:=TriangleObj;
        MoveL PickTriangle,v100,fine,Servo\WObj:=TriangleObj;
        g_GripOut;
        WaitTime 1;
        MoveL ApproachTriangle,v100,fine,Servo\WObj:=TriangleObj; 
        MoveJ Right_StartPose,v100,fine,Servo\WObj:=RightArm;
